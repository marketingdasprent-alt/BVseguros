# BV SEGUROS — configuração Apache (alojamento partilhado cPanel)
# Site 100% estático: HTML + CSS + JS. Não requer PHP.

DirectoryIndex index.html index.htm

<IfModule mod_authz_core.c>
  Require all granted
</IfModule>
<IfModule !mod_authz_core.c>
  Order allow,deny
  Allow from all
</IfModule>

Options -Indexes

<IfModule mod_mime.c>
  AddType text/css                 .css
  AddType application/javascript   .js
  AddType image/png                .png
  AddType image/svg+xml            .svg
  AddType image/webp               .webp
</IfModule>

<IfModule mod_deflate.c>
  AddOutputFilterByType DEFLATE text/html text/css application/javascript text/plain image/svg+xml
</IfModule>

<IfModule mod_expires.c>
  ExpiresActive On
  ExpiresByType text/css               "access plus 7 days"
  ExpiresByType application/javascript "access plus 7 days"
  ExpiresByType image/png              "access plus 30 days"
  ExpiresByType image/svg+xml          "access plus 30 days"
  ExpiresDefault                       "access plus 1 day"
</IfModule>

<IfModule mod_headers.c>
  Header set X-Content-Type-Options "nosniff"
  Header set X-Frame-Options "SAMEORIGIN"
  Header set Referrer-Policy "strict-origin-when-cross-origin"
  Header set Permissions-Policy "geolocation=(), microphone=(), camera=()"
</IfModule>

# Bloquear ficheiros de desenvolvimento, documentação e o CRM (é outro alojamento)
<FilesMatch "^(server\.js|package\.json|package-lock\.json|\.gitignore)$">
  <IfModule mod_authz_core.c>
    Require all denied
  </IfModule>
  <IfModule !mod_authz_core.c>
    Order allow,deny
    Deny from all
  </IfModule>
</FilesMatch>

<FilesMatch "\.(md|markdown)$">
  <IfModule mod_authz_core.c>
    Require all denied
  </IfModule>
  <IfModule !mod_authz_core.c>
    Order allow,deny
    Deny from all
  </IfModule>
</FilesMatch>

RedirectMatch 404 ^/crm/?
