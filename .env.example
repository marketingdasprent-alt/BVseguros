# Formulários do site → /api/pedido (api/pedido.ts) → Supabase. O browser já não fala com o Supabase.
# Na Vercel do site, definir as mesmas variáveis em Project Settings → Environment Variables.

# Mesmo projeto Supabase do CRM. A service_role só existe no servidor: nunca com prefixo VITE_.
SUPABASE_URL=
SUPABASE_SERVICE_ROLE_KEY=

# Cloudflare Turnstile (dash.cloudflare.com → Turnstile → Add widget, modo "Managed").
# Em desenvolvimento servem as chaves de teste da Cloudflare, que passam sempre:
#   VITE_TURNSTILE_SITE_KEY=1x00000000000000000000AA
#   TURNSTILE_SECRET_KEY=1x0000000000000000000000000000000AA
VITE_TURNSTILE_SITE_KEY=
TURNSTILE_SECRET_KEY=

# Texto aleatório longo (ex.: `openssl rand -hex 32`), para cifrar o IP no limite de pedidos.
IP_HASH_SEGREDO=
