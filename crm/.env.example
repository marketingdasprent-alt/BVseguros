VITE_SUPABASE_URL=
VITE_SUPABASE_ANON_KEY=

# Só para as funções em api/ (servidor). Nunca prefixar com VITE_: iria para o browser.
# Supabase: Project Settings, API Keys, service_role.
SUPABASE_SERVICE_ROLE_KEY=
# Endereço do CRM: para onde levam os emails de convite e o link do aviso de lead.
CRM_SITE_URL=

# Aviso por email de leads novos do site (api/aviso-lead.js). Opcional: sem a chave
# Brevo o aviso fica só dentro do CRM (contador no menu Leads).
# O segredo é inventado por si e colado também no header do Database Webhook do Supabase.
AVISO_LEAD_SEGREDO=
BREVO_API_KEY=
# Remetente validado na Brevo (ex.: crm@<domínio da BV>).
BREVO_REMETENTE=
