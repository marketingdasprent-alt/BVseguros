{
  "version": "0.0.1",
  "configurations": [
    {
      "name": "site",
      "runtimeExecutable": "npm",
      "runtimeArgs": [
        "run",
        "dev"
      ],
      "port": 5190,
      "autoPort": true
    },
    {
      "name": "crm",
      "runtimeExecutable": "npm",
      "runtimeArgs": [
        "--prefix",
        "crm",
        "run",
        "dev"
      ],
      "port": 5183
    },
    {
      "name": "site-build",
      "runtimeExecutable": "node",
      "runtimeArgs": [
        "node_modules/vite/bin/vite.js",
        "preview",
        "--port",
        "4173",
        "--strictPort"
      ],
      "port": 4173
    }
  ]
}
